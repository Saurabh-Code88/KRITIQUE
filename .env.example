# Database
POSTGRES_USER=kritique
POSTGRES_PASSWORD=kritique_secret
POSTGRES_DB=kritique_db
DATABASE_URL="postgresql://kritique:kritique_secret@postgres:5432/kritique_db"

# Redis
REDIS_URL=redis://redis:6379

# Auth
JWT_SECRET=replace_with_a_long_random_string_min_32_chars

# AI provider
# Get an API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# App
NODE_ENV=development
PORT=4000
# Docker host port for the backend. Use 4001 if you also run the backend locally on PORT=4000.
BACKEND_HOST_PORT=4000
FRONTEND_URL=http://localhost:5173
